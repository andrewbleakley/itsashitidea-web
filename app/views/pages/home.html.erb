<section class="mx-auto flex min-h-svh max-w-5xl flex-col items-center justify-center gap-6 px-4 py-12 text-center">
  <h1 class="text-[clamp(2.75rem,11vw,7rem)] font-extrabold leading-[0.96] tracking-[-0.03em] text-balance">
    Friends don’t let friends launch <span class="tag">AI slop.</span>
  </h1>

  <%= image_tag "poo-filament.svg", alt: "The It’s a Shit Idea mascot glowing inside a lightbulb, looking pleased with itself",
        class: "w-[min(80vw,26rem)] h-auto", width: 1024, height: 1024 %>

  <p class="max-w-2xl text-[clamp(1.5rem,5vw,2.75rem)] font-bold leading-[1.1] tracking-[-0.01em] text-balance">
    Avoid the butt hurt — let us tell them anonymously.
  </p>

  <a href="#nominate"
     class="mt-2 inline-flex min-h-11 items-center rounded-full bg-ink px-7 py-3 text-lg font-bold text-butter motion-safe:transition-transform motion-safe:hover:-rotate-2 focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-ink">
    Nominate a shit idea
  </a>
</section>

<section id="nominate" class="mx-auto max-w-xl scroll-mt-8 px-4 pb-20">
  <p class="eyebrow text-ink-soft">Nominate a shit idea</p>
  <h2 class="mt-3 text-[clamp(2rem,7vw,3.25rem)] font-extrabold leading-[0.98] tracking-[-0.03em] text-balance">
    Tell us what they’re about to launch.
  </h2>
  <p class="mt-4 text-lg leading-normal text-ink-soft">
    Drop the app name or website below. We don’t ask who you are, and they’ll never know it was you.
  </p>

  <%= render "nominations/form", nomination: @nomination %>
</section>

<footer class="px-4 pb-10 text-center">
  <p class="text-xl font-extrabold tracking-[0.02em]">It’s a Shit Idea</p>
</footer>
